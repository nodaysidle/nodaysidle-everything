#!/bin/bash
# Desktop launcher for Craft Anything: starts the local server if it is not
# already running, then opens the UI as an app window.
set -euo pipefail

port="${CRAFT_ANYTHING_PORT:-7420}"
data="${XDG_DATA_HOME:-$HOME/.local/share}/craft-anything"
url="http://127.0.0.1:$port/"
mkdir -p "$data/runs"

if ! curl -fsS -o /dev/null --max-time 1 "$url"; then
  # Run from the data folder so agent output never lands inside another project.
  cd "$data"
  setsid -f craft-anything --runs-dir "$data/runs" ui --port "$port" >>"$data/server.log" 2>&1
  for _ in $(seq 1 50); do
    curl -fsS -o /dev/null --max-time 1 "$url" && break
    sleep 0.1
  done
fi

if command -v omarchy-launch-webapp >/dev/null; then
  exec omarchy-launch-webapp "$url"
fi
exec xdg-open "$url"
